// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  phone             String   @unique
  email             String   @unique
  passwordHash      String
  dateOfBirth       DateTime
  gender            String
  heightCm          Float
  currentWeightKg   Float
  targetWeightKg    Float
  bloodGroup        String?
  country           String?
  state             String?
  city              String?
  lifestyle         String?
  occupation        String?
  wakeTime          String?
  sleepTime         String?
  dietaryPreference String?
  medicalConditions String?
  medications       String?
  allergies         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  goals             Goal[]
  weightLogs        WeightLog[]
  stepLogs          StepLog[]
  waterLogs         WaterLog[]
  exerciseLogs      ExerciseLog[]
  mealLogs          MealLog[]
  sleepLogs         SleepLog[]
  aiRecommendations AIRecommendation[]
}

model Goal {
  id                    String   @id @default(uuid())
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  goalType              String   // Weight Loss, Weight Gain, Weight Maintenance, Muscle Gain
  targetWeightKg        Float
  targetDate            DateTime
  bmr                   Float
  dailyCalorieTarget    Float
  proteinTargetGrams    Float
  waterTargetMl         Float
  stepTarget            Int
  weeklyWeightChangeKg  Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  logDate   DateTime @default(now())
}

model StepLog {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  steps      Int
  distanceKm Float?
  calories   Float?
  logDate    DateTime @default(now())
}

model WaterLog {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  quantityMl Int
  logTime    DateTime @default(now())
}

model ExerciseLog {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  exerciseType   String
  durationMin    Int
  caloriesBurned Float
  logDate        DateTime @default(now())
}

model SleepLog {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  hours      Float
  sleepScore Int?
  logDate    DateTime @default(now())
}

model MealLog {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  mealType         String
  mealTime         DateTime
  calories         Float
  protein          Float
  carbs            Float
  fat              Float
  mealImages       MealImage[]
  voiceTranscripts VoiceTranscript[]
  mealItems        MealItem[]
}

model MealImage {
  id              String   @id @default(uuid())
  mealLog         MealLog  @relation(fields: [mealId], references: [id])
  mealId          String
  imageUrl        String
  aiDetectedFood  String?
}

model VoiceTranscript {
  id              String   @id @default(uuid())
  mealLog         MealLog  @relation(fields: [mealId], references: [id])
  mealId          String
  transcript      String
  aiFoodSummary   String?
}

model MealItem {
  id              String   @id @default(uuid())
  mealLog         MealLog  @relation(fields: [mealId], references: [id])
  mealId          String
  name            String
  portion         String
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  sugar           Float?
  fiber           Float?
  healthScore     Int?
  recommendation  String?
}

model AIRecommendation {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  logDate         DateTime @default(now())
  adviceText      String
  categories      String?  // e.g., "Diet, Activity"
}
